        "SELECT DISTINCT stcd FROM sl325.wq_pcp_d WHERE spt >= DATE_SUB((SELECT MAX(spt) FROM sl325.wq_pcp_d), INTERVAL 30 DAY) ORDER BY stcd",
        "SELECT stcd, stnm FROM sl323.st_stbprp_b WHERE stcd IN ('HT0051000000000001', 'HT0051000000000002', 'HT0051000000000003')",
        "SELECT stcd, DATE(spt) AS dt, AVG(dox) AS avg_dox, AVG(codmn) AS avg_codmn, AVG(nh3n) AS avg_nh3n, AVG(tp) AS avg_tp, AVG(ph) AS avg_ph FROM sl325.wq_pcp_d WHERE spt >= DATE_SUB((SELECT MAX(spt) FROM sl325.wq_pcp_d), INTERVAL 30 DAY) GROUP BY stcd, DATE(spt) ORDER BY stcd, dt",
        "SELECT DATE(spt) AS dt, COUNT(*) AS cnt, COUNT(DISTINCT stcd) AS stcd_cnt FROM sl325.wq_pcp_d WHERE spt >= DATE_SUB((SELECT MAX(spt) FROM sl325.wq_pcp_d), INTERVAL 30 DAY) GROUP BY DATE(spt) ORDER BY dt",
        "SELECT DATE(spt) AS dt, COUNT(*) AS cnt, COUNT(DISTINCT stcd) AS stcd_cnt FROM sl325.wq_pcp_d GROUP BY DATE(spt) ORDER BY dt DESC LIMIT 60",
        "SELECT COUNT(DISTINCT stcd) AS total_stations FROM sl325.wq_pcp_d WHERE spt >= '2026-03-21' AND spt < '2026-04-01'",
        "SELECT b.stcd, b.stnm FROM sl323.st_stbprp_b b WHERE b.stcd IN (SELECT DISTINCT stcd FROM sl325.wq_pcp_d WHERE spt >= '2026-03-21' AND spt < '2026-04-01') ORDER BY b.stcd LIMIT 100",
        "SELECT stcd, DATE(spt) AS dt, AVG(dox) AS avg_dox, AVG(codmn) AS avg_codmn, AVG(nh3n) AS avg_nh3n, AVG(tp) AS avg_tp, AVG(ph) AS avg_ph FROM sl325.wq_pcp_d WHERE spt >= '2026-03-21' AND spt < '2026-04-01' GROUP BY stcd, DATE(spt) ORDER BY stcd, dt"
